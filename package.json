{
  "name": "agent-bus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hosted MCP + REST message bus so Claude Code agents and Grok Bots can talk both ways",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts",
    "mint": "bun run scripts/mint.ts",
    "migrate": "wrangler d1 execute agent-bus --remote --file=migrations/0001_init.sql",
    "migrate:local": "wrangler d1 execute agent-bus --local --file=migrations/0001_init.sql"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.147.0"
  }
}
